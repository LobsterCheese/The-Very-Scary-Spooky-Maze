  m_Name: Maze1SignDialogue
  m_EditorClassIdentifier: 
  dialogueList:
  - 'Welcome to the first maze! '
  - It is recommended you bring a flashlight for this.
  - This trail is populated by spooks!
  - They're little ghosts that will try to scare you.
  - Just shine your flashlight at them to scare them off.
  - If you ever get lost, press space to leave a helpful marker!
  - Happy trails!
  sound: {fileID: 8300000, guid: 691fd289276b8cd45954c08f20451cfb, type: 3}
